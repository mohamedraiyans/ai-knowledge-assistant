# ===================================================================
# AI Knowledge Assistant - Environment Configuration
#
# ONE .env file at the repo root. docker-compose.yml and apps/api both
# read it (apps/api finds it two directories up from its working
# directory). apps/web reads apps/web/.env.local instead.
#
# Only secrets and addresses live here. Branding, the system prompt,
# the model, retrieval settings, features and who may sign in are all
# changed in the Admin area, with no file edits.
# ===================================================================

# --- App ---
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
PORT=4000

# --- Backing services (the addresses below are for running the api on your
# host; docker-compose overrides them with service names for the api container) ---
DATABASE_URL=postgresql://slm:slm@localhost:5432/slm
REDIS_URL=redis://localhost:6379
CHROMA_URL=http://localhost:8000

# --- Knowledge graph (Neo4j, GraphRAG). Leave NEO4J_URI unset to turn the graph off. ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Also used by docker-compose to set Neo4j's own password on first start.
NEO4J_PASSWORD=slmgraph123

# --- Auth ---
# Access tokens are short-lived JWTs signed with this secret. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=REPLACE_ME

# Optional. Emails here always become admins on sign-in. You do not need it: the
# FIRST person to sign in to a fresh install becomes the admin, and admins can then
# invite everyone else from Admin -> Users.
ADMIN_EMAILS=

# --- Google OAuth (login) ---
# Create your own OAuth client at console.cloud.google.com -> APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID (type: Web application).
# Add this Authorized redirect URI:  http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- Provider-key vault encryption ---
# AES-256-GCM master key, base64, must decode to exactly 32 bytes. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes every stored provider key unreadable.
CREDENTIALS_ENCRYPTION_KEY=REPLACE_ME

# --- Optional: LangSmith tracing ---
# LangChain picks these up automatically and sends a trace of every chain/graph run
# to LangSmith. The built-in Usage & quality tab works without them.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ai-knowledge-assistant

# --- Docker only: the address the BROWSER uses to reach the api (compiled into the web
# bundle at build time). Change it when serving from a real domain. ---
# PUBLIC_API_URL=http://localhost:4000
